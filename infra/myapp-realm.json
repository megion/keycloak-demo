{
  "id": "myapp",
  "realm": "myapp",
  "enabled": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular MyApp user"
      },
      {
        "name": "admin",
        "description": "MyApp administrator"
      }
    ],
    "client": {
      "myapp-backend": [
        {
          "name": "admin",
          "description": "Role assigned to the backend service account via Client Service Roles"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "myapp-frontend",
      "name": "MyApp Angular frontend",
      "description": "Angular SPA that logs in through Keycloak (OAuth2 authorization code + PKCE)",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:4200"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ]
    },
    {
      "clientId": "myapp-backend",
      "name": "MyApp backend REST API",
      "description": "Node.js REST API protected by Keycloak JWTs; its audience is required on user tokens",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "secret": "myapp-backend-service-account-secret",
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "myapp-cli",
      "name": "MyApp demo CLI (password grant for curl testing)",
      "description": "Confidential client used only to demo REST calls with curl (ROPC); the Angular app never uses it",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "secret": "myapp-cli-secret",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "groups": [
    {
      "id": "users",
      "name": "MyApp users",
      "realmRoles": [
        "user"
      ],
      "attributes": {
        "defaultGroup": [
          "true"
        ]
      }
    },
    {
      "id": "admins",
      "name": "MyApp administrators",
      "realmRoles": [
        "user",
        "admin"
      ],
      "attributes": {
        "defaultGroup": [
          "false"
        ]
      }
    },
    {
      "name": "backend-service-accounts",
      "realmRoles": [
        "admin"
      ]
    }
  ],
  "users": [
    {
      "id": "alice",
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Anderson",
      "email": "alice@example.com",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "department": [
          "Finance"
        ],
        "preferredLanguage": [
          "en"
        ],
        "phone": [
          "+1 555 0100"
        ]
      },
      "realmRoles": [
        "user",
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Alice123!"
        }
      ],
      "notBefore": 0,
      "requiredActions": []
    },
    {
      "id": "bob",
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Brown",
      "email": "bob@example.com",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "department": [
          "Operations"
        ],
        "preferredLanguage": [
          "en"
        ]
      },
      "realmRoles": [
        "user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Bob12345!"
        }
      ],
      "notBefore": 0,
      "requiredActions": []
    }
  ],
  "clientScopes": [
    {
      "name": "myapp-backend-audience",
      "description": "Marks the backend API as the token audience and exposes realm roles in the realmRoles claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Access the MyApp backend API"
      },
      "protocolMappers": [
        {
          "name": "backend audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "myapp-backend",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realmRoles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic",
    "myapp-backend-audience"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "microprofile-jwt",
    "phone",
    "address",
    "organization"
  ]
}