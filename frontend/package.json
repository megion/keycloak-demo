  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" angular.json eslint.config.ts package.json proxy.conf.json tsconfig.json tsconfig.app.json tsconfig.spec.json",
