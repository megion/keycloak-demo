{
  "name": "myapp-backend",
  "version": "1.0.0",
  "description": "MyApp backend REST API protected by Keycloak",
  "license": "MIT",
  "main": "dist/server.js",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" eslint.config.ts jest.config.js package.json tsconfig.json tsconfig.test.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" eslint.config.ts jest.config.js package.json tsconfig.json tsconfig.test.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0"
  }
}
